{% if not output_type %}
type (possible values "string", "number", "dataframe", "plot"),value must be a dict,Examples: 
{ "type": "string", "value": {"key1":f"The highest salary is {highest_salary"},"key2":f"{staff}has the highest efficiency"}.",... } 
or { "type": "number", "value": {"key1":"123"} } 
or { "type": "dataframe", "value": {"key1":pd.DataFrame({...}),"key2":pd.DataFrame({...}),...} } 
or { "type": "plot", "value": {"key1""temp_chart1.png","key2""temp_chart1.png",...} }
{% elif output_type == "number" %}
type (must be "number"), value must be a dict,Example: { "type": "number", "value": {"key1":123,"key2":100,...}}
{% elif output_type == "string" %}
{ "type": "string", "value": {"key1":f"The highest salary is {highest_salary"},"key2":f"{staff}has the highest efficiency"}.",... }
{% elif output_type == "dataframe" %}
type (must be "dataframe"), value must be dict. Example: { "type": "dataframe", "value": {"key1":pd.DataFrame({...}),"key2":pd.DataFrame({...}),...} }
{% elif output_type == "plot" %}
type (must be "plot"), value must be dict. Example: { "type": "plot", "value": {"key1""temp_chart1.png","key2""temp_chart1.png",...} }.
{% endif %}

