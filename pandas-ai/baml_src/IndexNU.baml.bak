class IndexNU{
  task_id string @description(#"
    案例id，从$task_id获取
  "#) 

  indexNetUnitTriples IndexNetUnitTriple[] @description(#"
    指标和指标网元维度的三元组集合，从以下地方抽取：
    1、从$results[*].data[*].row[*]..用户指标集中性分析[*]的'网元维度*'里面抽取指标实体
    2、从$results[*].data[*].row[*]..用户指标集中性分析[*]的'网元维度*'抽取多个指标的网元实体
    3、只提取指标'有集中性'的指标实体
  "#)    
}

// class IndexAndIndexTimeSliceTriple {
class IndexNetUnitTriple {
  h IndexNetUnit  @description(#"
    头部节点,设置为指标实体
  "#) 
  t NetUnit  @description(#"
    尾部节点,设置网元实体
  "#) 
  r IndexAndNetUnitRel @description(#"
      指标和网元的关系
  "#) 
  @@stream.done
}
// class IndexAndIndexTimeSliceRelation {
class IndexNetUnit {
  tp string @description(#"
    设置为设置index
  "#)  
  n string @description(#"
    指标名称，从$results[*].data[*].row[*]..用户指标集中性分析[*]数组中抽取，并且必须在以'网元维度'开头的数组元素里面抽取，指标名称在'小区维度，指标：'后面，例如以下数组元素：
    '网元维度，指标：上行乱序率(HTTPS)(%)，有集中性，集中度为0.7500，高于阈值0.5000'
    这里面'上行乱序率(HTTPS)(%)'中'上行乱序率(HTTPS)'就是指标名称,最右边'(%)'是单位，其他指标也一样，切记不要附加到指标名称后面
  "#) 
}
// class Index {
class NetUnit {
  tp string @description(#"
    设置为nu
  "#)
  n string @description(#"
    网元名称，从$results[*].data[*].row[*]..用户指标集中性分析[*]数组中抽取，并且必须在以'网元维度'开头的数组元素里面抽取，查找'、指标值'前面的网元名称，例如以下数组元素：
     '网元维度，指标：上行乱序率(HTTPS)(%)，有集中性，集中度为0.7500，高于阈值0.5000\n\tSZHUPF018BHW、指标值：5.22, 乱序次数：293.00, 总次数：5613.00, 影响度：-0.4229\n\tAPP-HNZJIgdAMF020BHW-02AHW012、指标值：85.71, 成功次数：24.00, 总次数：28.00'
      这里面'SZHUPF018BHW','APP-HNZJIgdAMF020BHW-02AHW012'就是网元名称
  "#)  
  
}

class IndexAndNetUnitRel {
  v string @description(#"
    指标值，$results[*].data[*].row[*]..用户指标集中性分析[*]..网元维度名称后面的'指标值:'里面抽取，例如：
    'SZHUPF018BHW、指标值：5.22, 乱序次数：293.00, 总次数：5613.00, 影响度：-0.4229'
    这里面5.22是指标值，293.00是指标分子，5613.00是指标分母
  "#)
  j string @description(#"
    指标是否有集中性，$results[*].data[*].row[*]..用户指标集中性分析[*]..提取网元维度的指标有无集中性，'有集中性'设置为1，'无集中性'设置为0
  "#)    
  z string @description(#"
    指标分子
  "#)   
  m string @description(#"
    指标分母
  "#)   
  n string @description(#"
    设置值"bt"，表示指标归属某个网元
  "#) 

}
 


function GenIndexNU(json:string) -> IndexNU { 
  client Hs_deepseek_v3_250324
  // client Hs_deepseek_r1
  // client QwenCodeV2_5

  prompt #"    
    你是一个JSON结构和图数据分析专家，擅长从JSON结构中抽取实体和实体关系信息。
    我会提供详细的JSON结构给你，你需要仔细分析JSON的结构，按照我要求的输出格式生成一个图数据结构。
    {{IndexList()}}
    ###JSON###
    {{json}}
    {{ ctx.output_format }}
  "# 
}

test TestIndexNU {
  functions [GenIndexNU]
  args {
    json #"
        统计开发人员的缺陷数量并且列出开发人员的详细信息  
    "#
  }
}  